# ============================================
# Fake News Detection System - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Application ----
APP_NAME=fake-news-detector
APP_ENV=development
DEBUG=true

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# ---- Database ----
# SQLite (development)
DATABASE_URL=sqlite:///./fake_news.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/fake_news_db

# ---- Google Fact Check API ----
# Get your API key at: https://developers.google.com/fact-check/tools/api
# Leave empty to use mock evidence data
GOOGLE_FACT_CHECK_API_KEY=

# ---- ML Models ----
# Directory where trained model checkpoints are stored
MODELS_DIR=../models
# Default model to use for analysis (fakebert | xlm-roberta | muril | ensemble)
DEFAULT_MODEL=ensemble

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
